                },
                "kafka.region": {
                  "type": "string",
                  "description": "The kafka cluster region."
                },
                "kafka.api.key": {
                  "type": "string",
                  "description": "The kafka cluster api key."
                },
                "kafka.api.secret": {
                  "type": "string",
                  "description": "The kafka cluster api secret key.",
                  "x-redact": true
                }
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
