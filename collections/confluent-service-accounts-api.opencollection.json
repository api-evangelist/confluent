{
  "opencollection": "1.0.0",
  "info": {
    "name": "Confluent Cloud Kafka REST ACLs Service Accounts API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Service Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List service accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.confluent.cloud/iam/v2/service-accounts"
          },
          "docs": "List service accounts"
        },
        {
          "info": {
            "name": "Create a service account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.confluent.cloud/iam/v2/service-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a service account"
        }
      ]
    }
  ],
  "bundled": true
}