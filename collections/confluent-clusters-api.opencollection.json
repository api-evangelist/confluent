{
  "opencollection": "1.0.0",
  "info": {
    "name": "Confluent Cloud Kafka REST ACLs Clusters API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clusters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Kafka clusters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.confluent.cloud/kafka/v3/clusters"
          },
          "docs": "List Kafka clusters"
        },
        {
          "info": {
            "name": "Get a Kafka cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.confluent.cloud/kafka/v3/clusters/:cluster_id",
            "params": [
              {
                "name": "cluster_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a Kafka cluster"
        }
      ]
    }
  ],
  "bundled": true
}