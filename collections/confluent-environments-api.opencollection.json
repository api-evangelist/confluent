{
  "opencollection": "1.0.0",
  "info": {
    "name": "Confluent Cloud Kafka REST ACLs Environments API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Confluent Cloud environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.confluent.cloud/org/v2/environments"
          },
          "docs": "List Confluent Cloud environments"
        },
        {
          "info": {
            "name": "Create an environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.confluent.cloud/org/v2/environments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an environment"
        }
      ]
    }
  ],
  "bundled": true
}